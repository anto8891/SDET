

import java.util.Iterator;
import java.util.Set;
import java.util.concurrent.TimeUnit;

import org.openqa.selenium.By;
import org.openqa.selenium.JavascriptExecutor;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

public class ThirdQuestion {

	public static void main(String[] args) throws InterruptedException {
		System.setProperty("Webdriver.chrome.driver","C:\\Users\\Aruna Vishvanathan\\eclipse-workspace\\SeleniumFirst\\driver\\chromedriver.exe");
		WebDriver driver =  new ChromeDriver();	
		driver.manage().window().maximize();
		
		try {
		driver.get("https://autify.com/");
		System.out.println("Browser launched");
		
		Thread.sleep(3000);
		WebElement HelpCenterlink = driver.findElement(By.xpath("/html/body/div[2]/div[2]/div/nav/a[2]"));
		HelpCenterlink.click();
		
		String parenWindow = driver.getWindowHandle();
		Set<String> allwindows = driver.getWindowHandles();
		Iterator<String> iterator = allwindows.iterator();
		
		String childWindowHandle = "";
		while (iterator.hasNext()) {
			String windowHandle = iterator.next();
			if(!windowHandle.equals(parenWindow)) {
				childWindowHandle = windowHandle;
				break;
			}
		}
		
		driver.switchTo().window(childWindowHandle);
		Thread.sleep(1000);
		String childWindowTitle = driver.getTitle();
		System.out.println("Title of the child window:" + childWindowTitle );
		
		 if(childWindowTitle.contains("Autify")) {
			 System.out.println("Title is correct for the child window");
		 }
		 else {
			 System.out.println("Title is incorrect for the child window");
		 }
		 
		 Thread.sleep(1000);
		 // After verification close the child window only
		 driver.close();
		 driver.switchTo().window(parenWindow);
		 Thread.sleep(1000);
		 
		}
		
		catch (Exception e) {
			e.printStackTrace();
		}
		finally {
			driver.quit();
		}

		
		

	}

}
